#include <bits\stdc++.h>

using namespace std;

void fixedWindowTemplate(const vector<int>& arr, int k) {
    int n = arr.size();
    
    // 1. تعريف أدوات الحساب (عداد، مجموع، إلخ)
    long long current_window_sum = 0;
    long long max_sum = 0;

    int l = 0;
    for (int r = 0; r < n; ++r) {
        // [أضف العنصر الجديد من اليمين للتأثير الحالي]
        current_window_sum += arr[r];

       
        if (r - l + 1 > k) {
            current_window_sum -= arr[l]; 
            ++l;                        
        }

        
        if (r - l + 1 == k) {
        
            max_sum = max(max_sum, current_window_sum);
        }
    }
    
    cout << "Max sum of window size " << k << " is: " << max_sum << endl;
}

int variableWindowTemplate(const vector<int>& arr) {
    int n = arr.size();
    unordered_map<int, int> cnt;
    
    int l = 0;
    int max_length = 0;

    for (int r = 0; r < n; ++r) {
  
        cnt[arr[r]]++;

        while (cnt[arr[r]] > 1) { 
            cnt[arr[l]]--; 
            ++l;           
        }

      
        int current_window_size = r - l + 1;
        max_length = max(max_length, current_window_size); 
    }

    return max_length;
}



int max2DWindowSum(const vector<vector<int>>& grid, int R, int C) {
    int rows = grid.size();
    int cols = grid[0].size();
    int max_total_sum = -1e9; 

   
    vector<int> col_sum(cols, 0);

    // 1. نتحرك بالنافذة الثابتة على الأسطر أولاً (رأسياً)
    int top = 0;
    for (int bottom = 0; bottom < rows; ++bottom) {
        
        // أضف السطر الجديد لعدّاد الأعمدة
        for (int j = 0; j < cols; ++j) {
            col_sum[j] += grid[bottom][j];
        }

        // إذا تجاوزنا عدد الأسطر المطلوب R، اطرد السطر العلوي
        if (bottom - top + 1 > R) {
            for (int j = 0; j < cols; ++j) {
                col_sum[j] -= grid[top][j];
            }
            ++top;
        }

        // 2. الآن عندما يصبح لدينا بالضبط R من الأسطر، نطبق Sliding Window 1D على الأعمدة (أفقياً)
        if (bottom - top + 1 == R) {
            int current_2d_sum = 0;
            int l = 0;

            for (int r = 0; r < cols; ++r) {
                current_2d_sum += col_sum[r]; // أضف العمود الجديد للنافذة

                // حافظ على عرض النافذة الثابت للأعمدة C
                if (r - l + 1 > C) {
                    current_2d_sum -= col_sum[l];
                    ++l;
                }

                // النافذة الآن بحجم R x C تماماً!
                if (r - l + 1 == C) {
                    max_total_sum = max(max_total_sum, current_2d_sum);
                }
            }
        }
    }

    return max_total_sum;
}
